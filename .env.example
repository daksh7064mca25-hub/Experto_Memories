# ExpertoMemories Unified Environment Configuration Template

# 1. Application URL
NEXT_PUBLIC_APP_URL=https://expertomemories.in

# 2. Authentication Secrets (32+ character high-entropy keys)
JWT_SECRET=your-secure-random-jwt-secret-min-32-chars
PASSWORD_GATE_SECRET=your-secure-password-gate-cookie-secret-key

# 3. Admin Studio Initial Setup Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-to-a-strong-production-password

# 4. MongoDB Production Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expertomemories?retryWrites=true&w=majority

# 5. Cloudflare R2 Media Storage (Persistent customer photos & videos)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_DOMAIN=https://media.example.com

# 6. Razorpay Payments (Server-verified INR checkout)
# For test mode, use keys starting with rzp_test_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# 7. Manual Direct UPI Configuration (With QR & UTR admin review)
MANUAL_UPI_ID=yourname@bank
MANUAL_UPI_NAME=Your Store Name
MANUAL_UPI_QR_URL=/images/upi-qr.jpeg
